{
  "rules": {
    ".read": false,
    ".write": false,
    "go": {
      ".read": true,
      "current": {
        ".write": true,
        ".validate": "newData.isString() && newData.val().length < 40"
      },
      "snap": {
        ".write": true,
        ".validate": "newData.hasChildren(['g', 'by', 't'])"
      },
      "presence": {
        "$tab": {
          ".write": true,
          ".validate": "$tab.length < 40 && newData.hasChildren(['a', 'c', 'g'])"
        }
      },
      "games": {
        "$g": {
          ".write": true,
          ".validate": "newData.hasChildren(['size', 'created'])",
          "size": {
            ".validate": "newData.val() === 9 || newData.val() === 13 || newData.val() === 19"
          },
          "created": {
            ".validate": "newData.isNumber()"
          },
          "moves": {
            "$i": {
              ".validate": "newData.hasChildren(['c', 'p']) && (newData.child('c').val() === 'b' || newData.child('c').val() === 'w') && newData.child('p').isNumber() && newData.child('p').val() >= -1 && newData.child('p').val() < 361"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "gotest": {
      ".read": true,
      "current": {
        ".write": true,
        ".validate": "newData.isString() && newData.val().length < 40"
      },
      "snap": {
        ".write": true,
        ".validate": "newData.hasChildren(['g', 'by', 't'])"
      },
      "presence": {
        "$tab": {
          ".write": true,
          ".validate": "$tab.length < 40 && newData.hasChildren(['a', 'c', 'g'])"
        }
      },
      "games": {
        "$g": {
          ".write": true,
          ".validate": "newData.hasChildren(['size', 'created'])",
          "size": {
            ".validate": "newData.val() === 9 || newData.val() === 13 || newData.val() === 19"
          },
          "created": {
            ".validate": "newData.isNumber()"
          },
          "moves": {
            "$i": {
              ".validate": "newData.hasChildren(['c', 'p']) && (newData.child('c').val() === 'b' || newData.child('c').val() === 'w') && newData.child('p').isNumber() && newData.child('p').val() >= -1 && newData.child('p').val() < 361"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "whiteboards": {
      "$room": {
        ".read": "$room.matches(/^[a-f0-9]{32}$/) && (!data.hasChild('lastActive') || data.child('lastActive').val() > now - 86400000)",
        "objects": {
          "$id": {
            ".write": "$room.matches(/^[a-f0-9]{32}$/) && $id.length <= 40 && newData.parent().parent().child('lastActive').isNumber() && newData.parent().parent().child('lastActive').val() > now - 86400000",
            ".validate": "newData.hasChildren(['kind', 'color', 'width', 'opacity']) && (newData.child('kind').val() === 'text' ? newData.hasChildren(['text', 'x', 'y']) : newData.hasChild('chunks'))",
            "kind": {
              ".validate": "newData.val() === 'pen' || newData.val() === 'highlight' || newData.val() === 'text'"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^#[a-fA-F0-9]{6}$/)"
            },
            "width": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1e15"
            },
            "hidden": {
              ".validate": "newData.isBoolean()"
            },
            "x": {
              ".validate": "newData.isNumber()"
            },
            "y": {
              ".validate": "newData.isNumber()"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "chunks": {
              "$chunk": {
                ".validate": "$chunk.matches(/^[0-9]{6}$/) && newData.isString() && newData.val().length <= 2048 && newData.val().matches(/^-?[0-9]+(\\.[0-9]+)?(e[+-]?[0-9]+)?( -?[0-9]+(\\.[0-9]+)?(e[+-]?[0-9]+)?)*$/)"
              }
            },
            "$other": {
              ".validate": false
            },
            "opacity": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "dx": {
              ".validate": "newData.isNumber()"
            },
            "dy": {
              ".validate": "newData.isNumber()"
            },
            "boxW": {
              ".validate": "newData.parent().child('kind').val() === 'text' && newData.isNumber() && newData.val() > 0"
            },
            "boxH": {
              ".validate": "newData.parent().child('kind').val() === 'text' && newData.isNumber() && newData.val() > 0"
            }
          }
        },
        "cursors": {
          "$client": {
            ".write": "$room.matches(/^[a-f0-9]{32}$/) && $client.matches(/^[a-f0-9]{32}$/) && (!newData.exists() || (root.child('whiteboards').child($room).child('lastActive').isNumber() && root.child('whiteboards').child($room).child('lastActive').val() > now - 86400000))",
            ".validate": "newData.hasChildren(['name', 'animal', 'emoji', 'color', 'x', 'y', 'updated']) && newData.child('name').isString() && newData.child('name').val().length <= 32 && newData.child('animal').isString() && newData.child('animal').val().length <= 20 && newData.child('emoji').isString() && newData.child('emoji').val().length <= 8 && newData.child('color').isString() && newData.child('color').val().matches(/^#[a-fA-F0-9]{6}$/) && newData.child('x').isNumber() && newData.child('x').val() >= -1e15 && newData.child('x').val() <= 1e15 && newData.child('y').isNumber() && newData.child('y').val() >= -1e15 && newData.child('y').val() <= 1e15 && newData.child('updated').val() === now",
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        },
        ".write": "$room.matches(/^[a-f0-9]{32}$/) && !newData.exists() && ((data.child('lastActive').isNumber() && data.child('lastActive').val() <= now - 86400000) || (!data.exists() && root.child('whiteboardExpiry').child($room).isNumber() && root.child('whiteboardExpiry').child($room).val() <= now - 86400000))",
        "lastActive": {
          ".write": "$room.matches(/^[a-f0-9]{32}$/) && newData.isNumber() && newData.val() === now && (!data.exists() || data.val() > now - 86400000)",
          ".validate": "newData.isNumber() && newData.val() === now && newData.parent().parent().parent().child('whiteboardExpiry').child($room).val() === newData.val()"
        }
      }
    },
    "whiteboardExpiry": {
      ".indexOn": ".value",
      ".read": "query.orderByValue && query.endAt === root.child('whiteboardCleanupCutoff').val() && query.limitToFirst === 100 && root.child('whiteboardCleanupCutoff').isNumber() && root.child('whiteboardCleanupCutoff').val() <= now - 86400000",
      "$room": {
        ".read": "$room.matches(/^[a-f0-9]{32}$/)",
        ".write": "$room.matches(/^[a-f0-9]{32}$/) && ((!newData.exists() && data.isNumber() && data.val() <= now - 86400000) || (newData.isNumber() && newData.val() === now && newData.parent().parent().child('whiteboards').child($room).child('lastActive').val() === newData.val()))",
        ".validate": "newData.isNumber() && newData.val() === now"
      }
    },
    "whiteboardCleanupCutoff": {
      ".read": true,
      ".write": "newData.isNumber() && newData.val() <= now - 86400000 && newData.val() > now - 86460000",
      ".validate": "newData.isNumber()"
    }
  }
}
